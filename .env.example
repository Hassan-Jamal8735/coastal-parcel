# Neon — Dashboard > your project > Connect > copy the POOLED connection string
DATABASE_URL=

# Session signing key — any long random string (generate with: openssl rand -base64 32)
SESSION_SECRET=

# Vercel Blob — Vercel Dashboard > Storage > Blob > create store > copy token
BLOB_READ_WRITE_TOKEN=

# Payments (test keys first, swap for live keys at launch)
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=

# Email — Resend is used when RESEND_API_KEY is set; otherwise SMTP (MAIL_*)
RESEND_API_KEY=
EMAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
# Where contact-form messages are emailed (defaults to Info@coastalparcel.com)
ADMIN_EMAIL=

# Public site URL (http://localhost:3000 locally, your domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
