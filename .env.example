# Neon — Dashboard > your project > Connect > copy the POOLED connection string
DATABASE_URL=

# Auth — any long random string (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Vercel Blob — Vercel Dashboard > Storage > Blob > create store > copy token
BLOB_READ_WRITE_TOKEN=

# Payments (test keys first, swap for live keys at launch)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# Email (Resend) — resend.com > API Keys
RESEND_API_KEY=
EMAIL_FROM=

# Public site URL (http://localhost:3000 locally, your domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
